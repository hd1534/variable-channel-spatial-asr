# --- generated datasets -----------------------------------------------------
# eval-dev ships WITH the repository: the challenge announcement requires the
# evaluation dataset inside the linked GitHub repo, and a seed plus a generator
# is not the dataset. See README.md "eval-dev 배포 규격".
#
# Two things still stay out. RIR bundles are generation internals that nothing
# in scoring reads and that the same seed reproduces. eval-test is the held-out
# split; committing its labels would defeat the point of holding it out.
data/**/rir/
data/eval-test/
# `make eval-dev` regenerates into this copy, never into data/eval-dev;
# `make eval-dev-check` compares their audio, labels and meta byte for byte.
data/eval-dev-rebuild/
*.flac

# --- submission and scoring artefacts ---------------------------------------
predictions.jsonl
scores.json
scores_*.json
runs/

# --- model weights ----------------------------------------------------------
checkpoints/
*.ckpt
*.pt
*.pth
*.safetensors

# --- python -----------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- editors / OS -----------------------------------------------------------
.DS_Store
.idea/
.vscode/
